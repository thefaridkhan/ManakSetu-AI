# ==========================================
# BIS Intelligent Assistant Configuration
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Database Configuration (MySQL)
DATABASE_URL="mysql://root:0786@localhost:3306/standardsai"

# JWT Authentication
JWT_SECRET=bis_intelligent_standards_jwt_secret_key_2026_super_secure_enterprise
JWT_EXPIRES_IN=7d

# AI / LLM Configuration (Google Gemini / OpenAI)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
# Optional OpenAI fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Vector Search & Embeddings
EMBEDDING_MODEL=text-embedding-004
VECTOR_STORE_TYPE=embedded
SIMILARITY_THRESHOLD=0.65
TOP_K_RETRIEVAL=6

# Redis / Caching (Optional)
REDIS_URL=redis://localhost:6379

# Ingestion Cron Scheduler (Default: Every 24 hours at 2:00 AM)
INGESTION_CRON_SCHEDULE="0 2 * * *"
AUTO_SYNC_ENABLED=true
