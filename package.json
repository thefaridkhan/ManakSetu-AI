{
  "name": "bis-intelligent-assistant",
  "version": "1.0.0",
  "description": "AI-powered Intelligent Assistant for Indian Standards and BIS Services for Industries and Consumers",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "start": "npm run start --workspace=backend",
    "start:backend": "npm run start --workspace=backend",
    "seed": "npm run seed --workspace=backend",
    "ingest": "npm run ingest --workspace=backend",
    "test": "npm run test --workspace=backend",
    "test:eval": "npm run test:eval --workspace=backend"
  },
  "keywords": [
    "bis",
    "indian-standards",
    "rag",
    "gemini",
    "ai-assistant",
    "isi-mark",
    "hallmarking",
    "qco"
  ],
  "author": "Bureau of Indian Standards AI Engineering Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
